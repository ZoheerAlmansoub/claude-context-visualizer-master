{
  "name": "agent-session-intelligence",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first web app to visualize and analyze Claude Code, Cursor, Pi, and OpenCode agent sessions.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZoheerAlmansoub/agent-session-intelligence.git"
  },
  "bugs": {
    "url": "https://github.com/ZoheerAlmansoub/agent-session-intelligence/issues"
  },
  "homepage": "https://github.com/ZoheerAlmansoub/agent-session-intelligence#readme",
  "keywords": [
    "claude-code",
    "cursor",
    "opencode",
    "agent",
    "context-window",
    "token-analysis",
    "llm",
    "governance",
    "developer-tools"
  ],
  "scripts": {
    "dev": "bun run dev:server & bun run dev:web",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "cd web && bun run dev",
    "build:web": "cd web && bun run build",
    "start": "bun server/index.ts",
    "start:app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start.ps1",
    "test": "bun test",
    "check:secrets": "bun scripts/check-secrets.ts",
    "hooks:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-git-hooks.ps1"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.20"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun": "^1.3.14",
    "typescript": "^5.6.0"
  }
}
